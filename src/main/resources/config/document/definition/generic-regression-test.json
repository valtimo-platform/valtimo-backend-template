            "type": "object",
            "enum": [
                {
                    "code": "0",
                    "name": "Niet van toepassing"
                },
                {
                    "code": "1",
                    "name": "Dag"
                },
                {
                    "code": "2",
                    "name": "Week"
                },
                {
                    "code": "3",
                    "name": "2 weken"
                },
